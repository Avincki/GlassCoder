<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GlassCoder.Core.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlassCoder.Core\GlassCoder.Core.csproj" />

    <!-- The console host, for the command line alone. Its verbs are the harness's public
         surface, and until the workplan verb was added nothing asserted that adding one leaves
         the others where they were. -->
    <ProjectReference Include="..\..\src\GlassCoder.Host\GlassCoder.Host.csproj" />
    <ProjectReference Include="..\GlassCoder.TestSupport\GlassCoder.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
