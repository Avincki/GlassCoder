<Window x:Class="GlassCoder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GlassCoder.Wpf.ViewModels"
        xmlns:views="clr-namespace:GlassCoder.Wpf.Views"
        xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
        Title="GlassCoder" Height="760" Width="1240">

  <Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Navigation is data-templated: selecting a surface swaps the view model, and WPF picks
         the view. No code-behind, no navigation service to keep in sync (CLAUDE.md §14). -->
    <DataTemplate DataType="{x:Type vm:TranscriptViewModel}">
      <views:TranscriptView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChangesViewModel}">
      <views:ChangesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MetricsViewModel}">
      <views:MetricsView />
    </DataTemplate>
  </Window.Resources>

  <!-- Ctrl+Enter runs, because the goal box now accepts a plain Enter as a newline: a
       multi-line description would otherwise have no way to submit from the keyboard. -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="Return" Command="{Binding RunCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1F2933" Padding="12,10">
      <!-- DockPanel, not a Grid: a right-docked child reserves its full width before the filling
           child measures, so the button column cannot be starved by the wrapping goal box. The
           equivalent Grid ([Auto][*][Auto]) let the star column consume the buttons' width and
           push them off the right edge. -->
      <DockPanel LastChildFill="True">
        <!-- Top-aligned: the header is now as tall as five lines of goal, so a vertically
             centred brand would float in the middle of it. -->
        <TextBlock DockPanel.Dock="Left" Text="GlassCoder" Foreground="White"
                   FontSize="18" FontWeight="Bold"
                   VerticalAlignment="Top" Margin="0,2,16,0" />

        <!-- The run controls, stacked in a column to the right of the goal box. The checkbox sits
             above Run because it changes what Run does and is read the instant Run is pressed -
             cause directly above effect. -->
        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
          <!-- Ticked before the run, never during it: the critic is part of what the run is, so
               swapping it mid-flight would make one run two arms. -->
          <CheckBox Content="Second opinion" Foreground="White" Margin="0,2,0,6"
                    IsChecked="{Binding UseRemoteCritic}"
                    IsEnabled="{Binding RemoteCriticAvailable}"
                    ToolTip="{Binding RemoteCriticTooltip}" />
          <Button Content="Run" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding RunCommand}"
                  ToolTip="Start the run. Ctrl+Enter does the same from the goal box." />
          <Button Content="Cancel" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding CancelCommand}" />
          <Button Content="Settings…" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding SettingsCommand}"
                  ToolTip="Endpoints, API keys, budgets and guardrails - and a check that the seam works." />
          <Button Content="About" Padding="18,4"
                  Command="{Binding AboutCommand}"
                  ToolTip="What this is, who built it, and which build you are running." />
        </StackPanel>

        <!-- Five lines visible, wrap, scroll past that: room for a real description rather than a
             one-line title. The goal still reaches the model as a plain string - a rich-text box
             would either strip its formatting on the way out or leak XAML into the prompt, so this
             stays a TextBox and any structure a user wants is theirs to write as plain text.
             Declared last so LastChildFill hands it the width the brand and buttons did not take. -->
        <TextBox VerticalAlignment="Stretch" Padding="6,4" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MinLines="5" MaxLines="5"
                 VerticalScrollBarVisibility="Auto"
                 SpellCheck.IsEnabled="True"
                 Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="12,6">
      <TextBlock Text="{Binding Status}" Foreground="#263238" TextWrapping="Wrap" />
    </Border>

    <!-- The second opinion on the finished run. It advises you rather than the agent, so it sits
         on the shell above the status bar and stays put whichever surface is selected. Retry is
         a button and only a button: a critic that could re-run the agent by itself would be
         deciding when the worker gets another attempt (CLAUDE.md §11). -->
    <Border DockPanel.Dock="Bottom" Background="#FFF8E1" BorderBrush="#E0B200" BorderThickness="0,1,0,1"
            Padding="12,8" Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding ReviewHeadline}" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ReviewSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5D4C00" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
          <Button Content="Retry with this" Padding="12,4" Command="{Binding RetryCommand}"
                  ToolTip="Runs the task again as a new attempt, with these findings added to the goal." />
          <Button Content="Dismiss" Padding="12,4" Margin="8,0,0,0" Command="{Binding DismissReviewCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox DockPanel.Dock="Left" Width="150" Margin="0" BorderThickness="0,0,1,0"
             ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedSurface}">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="14,10" />
          <Setter Property="FontSize" Value="14" />
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <ContentControl Content="{Binding CurrentView}" />
  </DockPanel>
</Window>
