<Window x:Class="GlassCoder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GlassCoder.Wpf.ViewModels"
        xmlns:views="clr-namespace:GlassCoder.Wpf.Views"
        xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
        Title="GlassCoder" Height="760" Width="1240">

  <Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:PromptSummaryConverter x:Key="PromptSummary" />
    <!-- Navigation is data-templated: selecting a surface swaps the view model, and WPF picks
         the view. No code-behind, no navigation service to keep in sync (CLAUDE.md §14). -->
    <DataTemplate DataType="{x:Type vm:TranscriptViewModel}">
      <views:TranscriptView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChangesViewModel}">
      <views:ChangesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MetricsViewModel}">
      <views:MetricsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RetrospectiveViewModel}">
      <views:RetrospectiveView />
    </DataTemplate>
  </Window.Resources>

  <!-- Ctrl+Enter runs, because the goal box now accepts a plain Enter as a newline: a
       multi-line description would otherwise have no way to submit from the keyboard. -->
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="Return" Command="{Binding RunCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}" Padding="12,10">
      <!-- DockPanel, not a Grid: a right-docked child reserves its full width before the filling
           child measures, so the button column cannot be starved by the wrapping goal box. The
           equivalent Grid ([Auto][*][Auto]) let the star column consume the buttons' width and
           push them off the right edge. -->
      <DockPanel LastChildFill="True">
        <!-- Top-aligned: the header is now as tall as five lines of goal, so a vertically
             centred brand would float in the middle of it. -->
        <TextBlock DockPanel.Dock="Left" Text="GlassCoder" Foreground="White"
                   FontSize="18" FontWeight="Bold"
                   VerticalAlignment="Top" Margin="0,2,16,0" />

        <!-- The run controls, stacked in a column to the right of the goal box. The checkbox sits
             above Run because it changes what Run does and is read the instant Run is pressed -
             cause directly above effect. -->
        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
          <!-- Ticked before the run, never during it: the critic is part of what the run is, so
               swapping it mid-flight would make one run two arms. -->
          <CheckBox Content="Second opinion" Foreground="White" Margin="0,2,0,6"
                    IsChecked="{Binding UseRemoteCritic}"
                    IsEnabled="{Binding RemoteCriticAvailable}"
                    ToolTip="{Binding RemoteCriticTooltip}" />
          <Button Content="Run" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding RunCommand}"
                  ToolTip="Start the run. Ctrl+Enter does the same from the goal box." />
          <Button Content="Cancel" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding CancelCommand}" />
          <Button Content="Settings…" Padding="18,4" Margin="0,0,0,4"
                  Command="{Binding SettingsCommand}"
                  ToolTip="Endpoints, API keys, budgets and guardrails - and a check that the seam works." />
          <Button Content="About" Padding="18,4"
                  Command="{Binding AboutCommand}"
                  ToolTip="What this is, who built it, and which build you are running." />
        </StackPanel>

        <!-- The goal box and, above it, the picker for the goals of recent runs. Declared last so
             LastChildFill hands the pair the width the brand and buttons did not take. -->
        <DockPanel LastChildFill="True">
          <!-- Hidden until there is something to pick: an always-present empty dropdown would be
               a control that does nothing on a first-ever start. -->
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                     Visibility="{Binding HasRecentGoals, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left" Text="Recent" Foreground="#B0BEC5" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <!-- Shows no selection once a pick has been applied, so the box below is the single
                 answer to "what will run" - see MainWindowViewModel.SelectedRecentGoal. -->
            <ComboBox ItemsSource="{Binding RecentGoals}" MaxDropDownHeight="360"
                      SelectedItem="{Binding SelectedRecentGoal}"
                      ToolTip="The goals of recent runs, newest first. Picking one replaces the box below.">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <!-- One line per prompt however many lines were typed, trimmed to the width,
                       with the whole of it on hover. -->
                  <TextBlock Text="{Binding Converter={StaticResource PromptSummary}}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>

          <!-- Five lines visible, wrap, scroll past that: room for a real description rather than a
               one-line title. The goal still reaches the model as a plain string - a rich-text box
               would either strip its formatting on the way out or leak XAML into the prompt, so this
               stays a TextBox and any structure a user wants is theirs to write as plain text. -->
          <TextBox VerticalAlignment="Stretch" Padding="6,4" FontSize="13"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinLines="5" MaxLines="5"
                   VerticalScrollBarVisibility="Auto"
                   SpellCheck.IsEnabled="True"
                   Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="12,6">
      <TextBlock Text="{Binding Status}" Foreground="#263238" TextWrapping="Wrap" />
    </Border>

    <!-- The second opinion on the finished run. It advises you rather than the agent, so it sits
         on the shell above the status bar and stays put whichever surface is selected. Retry is
         a button and only a button: a critic that could re-run the agent by itself would be
         deciding when the worker gets another attempt (CLAUDE.md §11). -->
    <Border DockPanel.Dock="Bottom" Background="#FFF8E1" BorderBrush="#E0B200" BorderThickness="0,1,0,1"
            Padding="12,8" Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding ReviewHeadline}" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ReviewSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5D4C00" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
          <Button Content="Retry with this" Padding="12,4" Command="{Binding RetryCommand}"
                  ToolTip="Runs the task again as a new attempt, with these findings added to the goal." />
          <Button Content="Dismiss" Padding="12,4" Margin="8,0,0,0" Command="{Binding DismissReviewCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The paused loop's question: a step or token ceiling tripped and the operator may buy
         one more allotment. The run makes no model calls while this shows - the banner is the
         run's next step, which is why it sits on the shell like the review does. Light red on
         purpose: of everything the shell can show, this is the one strip that is actively
         waiting on the operator, and it must not read like one more status line. -->
    <Border DockPanel.Dock="Bottom" Background="#FDECEA" BorderBrush="#C62828" BorderThickness="0,1,0,1"
            Padding="12,8" Visibility="{Binding HasLimitPrompt, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding LimitPrompt}" FontWeight="Bold"
                   TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#8C1D18" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Extend and continue" Padding="12,4" Command="{Binding ExtendLimitCommand}"
                  ToolTip="Raises the tripped limit by one more allotment of its configured size, for this run only." />
          <Button Content="Stop here" Padding="12,4" Margin="8,0,0,0" Command="{Binding StopAtLimitCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The centre of the shell is a Grid rather than more docking for one reason: the
         workspace pane is user-resizable, and a GridSplitter only works between columns. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <!-- MinWidths so neither side can be dragged out of existence: a content area or a
             pane squeezed to zero pixels reads as a feature that vanished, not one resized. -->
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="280" MinWidth="160" />
      </Grid.ColumnDefinitions>

      <!-- Pane chrome: the navigation belongs to the frame, not to the surface it selects. A step
           lighter than the header, which keeps the header reading as the top of the hierarchy. -->
      <ListBox Grid.Column="0" Margin="0" BorderThickness="0,0,1,0"
               Background="{StaticResource PaneBackground}"
               BorderBrush="{StaticResource PaneBorder}"
               Foreground="{StaticResource PaneForeground}"
               ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedSurface}">
        <ListBox.ItemContainerStyle>
          <!--
            Templated rather than merely recoloured. The stock item paints the system highlight -
            a pale blue behind near-black text - which on this background is the one combination
            that reads worse than no styling at all. The template also lets selection show as an
            accent bar as well as a fill: a fill alone is a weak signal at this contrast, and the
            selected surface is the one thing this list has to communicate.
          -->
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PaneForeground}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Grid Background="Transparent">
                    <Border x:Name="Fill" Background="Transparent" />
                    <Border x:Name="Accent" Width="3" HorizontalAlignment="Left"
                            Background="Transparent" />
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fill" Property="Background" Value="{StaticResource PaneHover}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Fill" Property="Background" Value="{StaticResource PaneSelected}" />
                      <Setter TargetName="Accent" Property="Background" Value="{StaticResource PaneAccent}" />
                      <Setter Property="Foreground" Value="White" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>

      <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

      <!-- Doubles as the pane's left border, so no separate separator is needed. Chrome-coloured
           now that the pane is: a light grey bar between a light surface and a dark pane would
           read as a gap in the frame rather than the edge of it. -->
      <GridSplitter Grid.Column="2" Width="5" Background="{StaticResource PaneBackground}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ToolTip="Drag to resize the workspace pane." />

      <!-- The workspace pane (workplan task 39). Shell-level like the review strip, not a
           surface: which folder the agent is in and what this session did to it stay visible
           whichever surface is selected. -->
      <views:WorkspacePane Grid.Column="3" DataContext="{Binding Workspace}" />
    </Grid>
  </DockPanel>
</Window>
