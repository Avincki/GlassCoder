<Window x:Class="GlassCoder.Wpf.Views.PassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passphrase" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinWidth" Value="80" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#1F2933" Padding="14,10">
      <StackPanel>
        <TextBlock x:Name="HeadingText" Foreground="White" FontSize="15" FontWeight="Bold" />
        <TextBlock x:Name="MessageText" Foreground="#B0BEC5" FontSize="11"
                   TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="12,8">
      <DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#B00020" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,12,0" />
        <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Margin="6,0,0,0"
                Click="OnConfirm" AutomationProperties.AutomationId="PassphraseOk" />
        <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" />
      </DockPanel>
    </Border>

    <StackPanel Margin="14,12">
      <TextBlock Text="Passphrase" Margin="0,0,0,3" Foreground="#37474F" />
      <PasswordBox x:Name="FirstBox" AutomationProperties.AutomationId="PassphraseBox" />

      <StackPanel x:Name="ConfirmPanel">
        <TextBlock Text="Confirm passphrase" Margin="0,0,0,3" Foreground="#37474F" />
        <PasswordBox x:Name="SecondBox" AutomationProperties.AutomationId="PassphraseConfirmBox" />
      </StackPanel>

      <TextBlock x:Name="HintText" Foreground="#78909C" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

  </DockPanel>
</Window>
