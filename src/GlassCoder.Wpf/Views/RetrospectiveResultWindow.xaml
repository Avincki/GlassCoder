<Window x:Class="GlassCoder.Wpf.Views.RetrospectiveResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
        Title="Proposed workplan" Height="640" Width="880"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5">

  <Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  </Window.Resources>

  <!-- Escape closes, and closing loses nothing: the surface shows the same list, and the
       Proposals button reopens this. That is what lets it be a window rather than a dialog. -->
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="Close" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="Close" Executed="OnClose" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1"
            Padding="14,10">
      <StackPanel>
        <TextBlock Text="What GlassCoder should learn from this run" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Margin="0,4,0,0" Foreground="#57606A" TextWrapping="Wrap"
                   Text="Tick what you want done. The ticked items become one Markdown work order a Claude Code session can implement in the GlassCoder repository - the rest stay in the file as the context that explains them." />
        <TextBlock Margin="0,4,0,0" Foreground="#57606A" Text="{Binding RunLabel}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
      <ItemsControl ItemsSource="{Binding Recommendations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,8">
              <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsAccepted}" VerticalAlignment="Top"
                          Margin="0,2,10,0" />

                <StackPanel>
                  <DockPanel LastChildFill="True">
                    <!-- The priority reads as a label rather than a colour: four levels are more
                         than a colour scale carries, and High is the only one that must not be
                         missed. -->
                    <Border DockPanel.Dock="Left" CornerRadius="2" Padding="5,1" Margin="0,0,8,0"
                            VerticalAlignment="Top">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#EAEEF2" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PriorityLabel}" Value="High">
                              <Setter Property="Background" Value="#FDECEA" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding PriorityLabel}" FontSize="11" Foreground="#42484F" />
                    </Border>

                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </DockPanel>

                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Foreground="#42484F"
                             Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                  <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#8C959F" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
            Padding="14,10">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Close" Padding="14,4" MinWidth="90" Margin="8,0,0,0"
                Command="Close" />
        <Button DockPanel.Dock="Right" Content="Write work order…" Padding="14,4" MinWidth="150"
                Command="{Binding WriteWorkOrderCommand}" ToolTip="{Binding WorkOrderTooltip}" />
        <Button DockPanel.Dock="Right" Content="Show file" Padding="10,4" Margin="0,0,8,0"
                Command="{Binding ShowOutputCommand}"
                Visibility="{Binding WorkOrderPath, Converter={StaticResource NotEmptyToVisibility}}" />

        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#42484F"
                   Text="{Binding Status}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
