<UserControl x:Class="GlassCoder.Wpf.Views.WorkspacePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
             Background="{StaticResource PaneBackground}"
             Foreground="{StaticResource PaneForeground}">
  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:RatingToCheckedConverter x:Key="RatingToChecked" />
  </UserControl.Resources>

  <!-- Background on the control rather than the DockPanel, so the 8px margin is chrome too and
       the pane does not sit in a thin frame of window default. -->
  <DockPanel Margin="8">
    <!-- The folder the agent works in. Read-only on purpose: the root is not something to type
         over - Browse picks one, and the strip below says what happens next. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0"
              Command="{Binding BrowseCommand}"
              ToolTip="Pick the project folder. Saved like any setting; a restart makes it the workspace in force." />
      <!-- An inset field: below the chrome rather than on it. A stock white box here would be the
           brightest thing in the pane, which is not what a read-only path deserves. -->
      <TextBox IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,2"
               Background="{StaticResource PaneField}"
               Foreground="{StaticResource PaneForeground}"
               BorderBrush="{StaticResource PaneBorder}"
               Text="{Binding RootPath, Mode=OneWay}" ToolTip="{Binding RootPath}" />
    </DockPanel>

    <!-- A chosen folder that is not the workspace yet. Same colours as the shell's other
         "a human decides here" strips. -->
    <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#E0B200" BorderThickness="1"
            CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
            Visibility="{Binding HasPendingRoot, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#5D4C00"
                   Text="{Binding PendingRoot, StringFormat='Saved. Runs work in {0} after a restart.'}" />
        <Button Content="Restart now" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0"
                Command="{Binding RestartCommand}" />
      </StackPanel>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,2" Margin="6,0,0,0"
              Command="{Binding RefreshCommand}"
              ToolTip="Re-read the whole tree from disk. The pane follows the workspace on its own; this is the way back if it ever stops." />
      <!-- Beside Refresh rather than beside Browse: it belongs with the tree's maintenance, not
           with choosing the workspace. Disabled mid-run - emptying folders an agent is writing
           would pull the workspace out from under it. -->
      <Button DockPanel.Dock="Right" Content="Clean" Padding="10,2" Margin="6,0,0,0"
              Command="{Binding CleanCommand}"
              ToolTip="Empty the writable roots so the next run starts from a blank workspace. Asks first; there is no undo." />
      <!-- The live check the verification ladder cannot do: a real window on the real desktop,
           dialogues and all. Runs detached on the host - the sandbox has no desktop to show a
           window on - and is the operator's to drive and to close. -->
      <Button DockPanel.Dock="Right" Content="Run app" Padding="10,2" Margin="6,0,0,0"
              Command="{Binding RunAppCommand}"
              ToolTip="Launch the workspace's application with dotnet run - a live, interactive window on your desktop. Builds first, so give it a moment." />
      <TextBlock Foreground="{StaticResource PaneMutedForeground}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Text="{Binding Status}" />
    </DockPanel>

    <!--
      Asked when the launched application closes, because that is the only moment the operator
      can honestly answer it. A strip rather than a modal box: a dialog on top of whatever they
      turned to next gets answered to make it go away, and a rating given to dismiss something is
      worse than none. Skip is therefore a first-class button, not a corner cross.
    -->
    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="8,6" CornerRadius="3"
            Background="#1E3A4C" BorderBrush="#2E5A73" BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsRatingApp}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <StackPanel>
        <TextBlock Foreground="{StaticResource PaneForeground}" TextWrapping="Wrap"
                   Text="{Binding RatedApplication, StringFormat='How did {0} look? Nothing else in a run judges the screen.'}" />

        <!--
          The whole scale on screen, rather than five of six options behind a click. A dropdown
          asks the operator to open it, read it, and then choose; this is one click on a row they
          have already read. The two faces are what make it answerable without reading at all -
          they say which end is which, which is the only thing a bare 0-to-5 row does not.
        -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
          <TextBlock Text="🙁" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,8,0"
                     VerticalAlignment="Center" ToolTip="0 - unusable" />

          <!-- One GroupName across the six, so choosing one clears the last. Spelled out rather
               than generated: ConverterParameter cannot be bound, so an ItemsControl over the
               scale would need a MultiBinding to say the same six things. -->
          <RadioButton GroupName="AppRating" Content="0" Margin="0,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=0}"
                       ToolTip="0 - unusable" />
          <RadioButton GroupName="AppRating" Content="1" Margin="0,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=1}" />
          <RadioButton GroupName="AppRating" Content="2" Margin="0,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=2}" />
          <RadioButton GroupName="AppRating" Content="3" Margin="0,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=3}" />
          <RadioButton GroupName="AppRating" Content="4" Margin="0,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=4}" />
          <RadioButton GroupName="AppRating" Content="5" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PaneForeground}"
                       IsChecked="{Binding AppRating, Mode=TwoWay, Converter={StaticResource RatingToChecked}, ConverterParameter=5}"
                       ToolTip="5 - exactly right" />

          <TextBlock Text="🙂" FontFamily="Segoe UI Emoji" FontSize="15"
                     VerticalAlignment="Center" ToolTip="5 - exactly right" />
        </StackPanel>

        <!-- Under the row rather than beside it: the pane is narrow, and eight items plus a
             sentence is what makes a strip wrap in the one place it must not. -->
        <TextBlock Text="0 unusable · 5 exactly right · recording is disabled until you choose"
                   Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource PaneMutedForeground}" />

        <TextBox Text="{Binding AppComment, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                 MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True"
                 Background="{StaticResource PaneField}" Foreground="{StaticResource PaneForeground}"
                 BorderBrush="{StaticResource PaneBorder}"
                 ToolTip="Optional. What was wrong, or what was right - it is recorded verbatim." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
          <Button Content="Skip" Padding="10,2" Margin="0,0,6,0" Command="{Binding SkipRatingCommand}" />
          <Button Content="Record" Padding="10,2" MinWidth="80" Command="{Binding SubmitRatingCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The tree follows the workspace: a file appears the moment its path does, whoever made
         it. Files the *current run* touched are green with their net +added −removed counts,
         and the folders above them open so a modification is never folded away. Folders start
         open, which is why there is no expand-all here to press. -->
    <TreeView ItemsSource="{Binding RootNodes}" BorderThickness="1"
              Background="{StaticResource PaneField}"
              BorderBrush="{StaticResource PaneBorder}"
              Foreground="{StaticResource PaneForeground}"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <TreeView.Resources>
        <!--
          The stock item paints the system highlight, which is a pale blue behind near-black text
          and unreadable here. Overriding the four brush keys recolours selection without taking
          on a full TreeViewItem template - and that template is worth avoiding, because it owns
          the expander glyph and the indentation as well, neither of which needs changing.

          Inactive is styled too, not just active: this tree loses focus every time the goal box
          or a button is used, and a selection that vanishes on focus loss reads as a click that
          did not register.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="{StaticResource PaneSelectedColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="{StaticResource PaneHoverColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                         Color="{StaticResource PaneForegroundColor}" />
      </TreeView.Resources>
      <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="Foreground" Value="{StaticResource PaneForeground}" />
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <!-- Transparent so the gaps between the name and its counts are hit-testable too; a
               null background is not, and a double-click that lands between two words would
               otherwise do nothing. -->
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <!-- Double-click, not single: selection moves with the arrow keys as well as the
                 mouse, and opening a window on every selection change would make the tree
                 unnavigable. OpenFileCommand declines directories, which leaves their
                 double-click to the TreeView's own expand. -->
            <StackPanel.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick"
                            CommandParameter="{Binding}"
                            Command="{Binding DataContext.OpenFileCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}" />
            </StackPanel.InputBindings>
            <TextBlock Text="{Binding Name}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                      <!-- The Changes surface's "Applied" green, carried onto the dark pane: same
                           hue, lightened until it is legible against it. The two surfaces still
                           agree that green means modified, which is the part that matters. -->
                      <Setter Property="Foreground" Value="{StaticResource PaneAdded}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                        Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Foreground="{StaticResource PaneAdded}"
                         Text="{Binding LinesAdded, StringFormat=+{0}}" />
              <TextBlock Foreground="{StaticResource PaneRemoved}" Margin="4,0,0,0"
                         Text="{Binding LinesRemoved, StringFormat=−{0}}" />
            </StackPanel>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
