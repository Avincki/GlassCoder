<UserControl x:Class="GlassCoder.Wpf.Views.RetrospectiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
             xmlns:hl="clr-namespace:GlassCoder.Wpf.Highlighting">
  <UserControl.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="NotToVisibility" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <conv:StageKindToBackgroundConverter x:Key="StageBackground" />
    <conv:StageKindToBorderConverter x:Key="StageBorder" />
  </UserControl.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Which run is being looked back at. Named before anything else, because everything below
         is about one run and the surface outlives the run that filled it. -->
    <Border Grid.Row="0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1"
            CornerRadius="3" Padding="10,8">
      <StackPanel>
        <TextBlock Text="{Binding RunLabel}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding RunGoal}" Foreground="#57606A" TextWrapping="Wrap"
                   MaxHeight="52" Margin="0,3,0,0"
                   Visibility="{Binding RunGoal, Converter={StaticResource NotEmptyToVisibility}}" />
      </StackPanel>
    </Border>

    <!-- The controls. The focus box is optional and stays out of the way, as the file viewer's
         does: an empty one takes the retrospective on its own terms. -->
    <DockPanel Grid.Row="1" Margin="0,8,0,0">
      <Button DockPanel.Dock="Left" Content="{Binding RunLabelForButton}" MinWidth="132" Padding="14,4"
              Command="{Binding RunCommand}" ToolTip="{Binding Tooltip}"
              Visibility="{Binding IsRunning, Converter={StaticResource NotToVisibility}}" />

      <Button DockPanel.Dock="Left" Content="Cancel" MinWidth="132" Padding="14,4"
              Command="{Binding CancelCommand}"
              ToolTip="Stops the stage in flight. Whatever finished before it is kept."
              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

      <Button DockPanel.Dock="Right" Content="Show file" Padding="10,4" Margin="6,0,0,0"
              Command="{Binding ShowOutputCommand}"
              ToolTip="Open the folder the work order was written to." />

      <Button DockPanel.Dock="Right" Content="Write work order…" Padding="10,4" Margin="6,0,0,0"
              Command="{Binding WriteWorkOrderCommand}"
              ToolTip="{Binding WorkOrderTooltip}" />

      <Button DockPanel.Dock="Right" Content="Proposals…" Padding="10,4" Margin="6,0,0,0"
              Command="{Binding ShowProposalsCommand}"
              ToolTip="Reopen the window with the proposed workplan." />

      <Grid Margin="10,0,0,0">
        <TextBox VerticalContentAlignment="Center" Padding="6,3"
                 Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                   Foreground="#8C959F" Text="Anything to focus on? (optional)">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Instructions}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DockPanel>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <!--
        Before the first retrospective: what this surface is, and how it differs from the review
        strip on the shell. Two things called an opinion on one window need telling apart, and the
        empty state is where there is room to do it.

        Grey, and the only grey here: it stands down the moment the first stage answers, and what
        replaces it is that stage's own colour. Gated on HasStages rather than HasResult, which is
        the whole change - HasResult is not true until all three are over, and waiting for that is
        what left this text on screen for a quarter of an hour with three reports finished behind
        it.
      -->
      <Border Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="3"
              Padding="16" VerticalAlignment="Top"
              Visibility="{Binding HasStages, Converter={StaticResource NotToVisibility}}">
        <StackPanel>
          <TextBlock Text="A look back at the finished run" FontWeight="SemiBold" FontSize="14" />
          <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#57606A"
                     Text="Headless Claude Code reads this run three ways: the code it produced, how it got there, and what GlassCoder itself should learn from both. The first two are reports to read. The third is a checklist you tick, and its ticked items become one Markdown work order a coding agent can implement in the GlassCoder repository." />
          <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#57606A"
                     Text="This is not the review strip at the bottom of the window. That one is the cheap second opinion on whether the run met its goal, and it advises a retry. This is the expensive one, it takes a few minutes, and it advises the harness's own backlog." />
        </StackPanel>
      </Border>

      <!--
        The stage reports, each appearing as its own session ends rather than all three at the
        close. The newest opens and the one before it folds; when the whole thing finishes the
        harness stage opens, and anything the operator had open stays open.

        One colour per stage - red, green, blue after the empty state's grey - so which of the
        three has just landed is answerable from across the room. It is progress, not judgement:
        a stage that could not answer says so in the amber box below, which is this surface's
        existing word for that.
      -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasStages, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding Stages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" CornerRadius="3" Margin="0,0,0,8"
                      Background="{Binding Stage.Kind, Converter={StaticResource StageBackground}}"
                      BorderBrush="{Binding Stage.Kind, Converter={StaticResource StageBorder}}">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="10,6">
                  <Expander.Header>
                    <DockPanel LastChildFill="False" MinWidth="560">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Headline}" Foreground="#57606A"
                                 Margin="12,0,0,0" />
                    </DockPanel>
                  </Expander.Header>

                  <StackPanel Margin="0,6,0,0">
                    <!-- A stage that could not answer says so where its report would be, rather
                         than showing an empty box that reads as "nothing to report". -->
                    <Border Background="#FFF8E1" BorderBrush="#E0B200" BorderThickness="1"
                            CornerRadius="3" Padding="8,6" Margin="0,0,0,6"
                            Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" Foreground="#5D4C00" />
                    </Border>

                    <RichTextBox IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 hl:HighlightedText.Lines="{Binding ReportLines}" />
                  </StackPanel>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!--
      The live feed, and the status line under it. It sits at the bottom because it is what the
      operator watches while there is nothing else to look at, and it collapses the moment the
      retrospective is over - the reports are the record, this is only the waiting made bearable.
    -->
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <Border Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3"
              Padding="8,6" MaxHeight="150"
              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer x:Name="ActivityScroller" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ActivityList" ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#D4D4D4" TextTrimming="CharacterEllipsis"
                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Margin="0,6,0,0" Foreground="#555" Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
