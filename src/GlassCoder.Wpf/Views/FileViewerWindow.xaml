<Window x:Class="GlassCoder.Wpf.Views.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GlassCoder.Wpf.Converters"
        Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        FontFamily="Cascadia Mono, Consolas" FontSize="12.5">

  <Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="NotToVisibility" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  </Window.Resources>

  <!-- Escape closes. A viewer opened by a double-click should be dismissable without reaching
       for the mouse again, and there is nothing here to lose by closing it. -->
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="Close" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="Close" Executed="OnClose" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      The review strip. It sits above both panes rather than inside the review column, because
      the button has to be reachable before there is a review column to put it in.
    -->
    <Border Grid.Row="0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1"
            Padding="12,8">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Content="Review" Padding="14,3" MinWidth="86"
                FontFamily="Segoe UI"
                Command="{Binding ReviewCommand}"
                ToolTip="{Binding ReviewTooltip}"
                Visibility="{Binding IsReviewing, Converter={StaticResource NotToVisibility}}" />

        <Button DockPanel.Dock="Left" Content="Cancel" Padding="14,3" MinWidth="86"
                FontFamily="Segoe UI"
                Command="{Binding CancelReviewCommand}"
                Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}" />

        <!-- Only offered once there is something to accept, so the strip stays quiet until then. -->
        <Button DockPanel.Dock="Right" Content="Show file" Padding="10,3" Margin="6,0,0,0"
                FontFamily="Segoe UI"
                Command="{Binding ShowExportCommand}"
                ToolTip="Open the folder the accepted actions were written to." />
        <Button DockPanel.Dock="Right" Content="Accept ticked…" Padding="10,3" Margin="6,0,0,0"
                FontFamily="Segoe UI"
                Command="{Binding ExportCommand}"
                ToolTip="Write every proposal to a Markdown file under .glasscoder/reviews, with the ticked ones marked."
                Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                   FontFamily="Segoe UI" FontSize="12" Foreground="#57606A"
                   Text="{Binding ReviewHeadline}"
                   Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}" />

        <!--
          The focus box is optional and stays out of the way: an empty one reviews the file on
          its own terms, which is what most presses want.
        -->
        <Grid Margin="10,0,0,0">
          <TextBox VerticalContentAlignment="Center" Padding="6,3"
                   FontFamily="Segoe UI" FontSize="12"
                   BorderBrush="#D0D7DE" Background="White"
                   Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" />
          <!-- Watermark by trigger rather than converter: the empty string is the whole test,
               and none of the shared converters inverts. -->
          <TextBlock IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                     FontFamily="Segoe UI" FontSize="12" Foreground="#8C959F"
                     Text="Anything to focus on? (optional)">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Instructions}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <!-- Opened by the code-behind when the first review lands; see FileViewerWindow.xaml.cs. -->
        <ColumnDefinition x:Name="ReviewColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <!-- What is shown when there is nothing to show: a file that is binary, too large, or gone. -->
      <TextBlock x:Name="Notice" Grid.Column="0" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="Segoe UI" FontSize="13" Foreground="#5F6B76"
                 TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />

      <Border x:Name="Body" Grid.Column="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!--
            The gutter is scrolled by offsetting it rather than by giving it its own ScrollViewer:
            one scrollable thing on the window means the numbers cannot drift out of step with the
            code, which is exactly what two synchronised scrollers eventually do. Clipped, because
            the offset moves it past its own top edge.
          -->
          <Border Grid.Column="0" ClipToBounds="True" Padding="8,0"
                  Background="{StaticResource SyntaxGutterBackground}"
                  BorderBrush="#D0D7DE" BorderThickness="0,0,1,0">
            <TextBlock x:Name="Gutter" TextAlignment="Right"
                       Foreground="{StaticResource SyntaxGutter}" />
          </Border>

          <!--
            A RichTextBox rather than a TextBlock so the code can be selected and copied, which is
            most of what a read-only viewer is for. IsReadOnly and IsUndoEnabled="False" keep it
            from behaving like the editor it resembles.
          -->
          <RichTextBox x:Name="Code" Grid.Column="1"
                       IsReadOnly="True" IsUndoEnabled="False"
                       BorderThickness="0" Padding="8,0"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       Foreground="{StaticResource SyntaxPlain}" />
        </Grid>
      </Border>

      <GridSplitter x:Name="ReviewSplitter" Grid.Column="1" Width="5" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" Background="#E3E7EB"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

      <!-- The review: prose on top, proposals below, each with its own scroll. -->
      <Border Grid.Column="2" Background="#FBFCFD" BorderBrush="#D0D7DE" BorderThickness="1,0,0,0"
              Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
          </Grid.RowDefinitions>

          <!--
            The report is coloured as Markdown rather than rendered as it: the highlighter is
            already here and already agrees with the rest of the window, and a renderer would be
            a second Markdown implementation to keep correct for one panel.
          -->
          <RichTextBox x:Name="Report" Grid.Row="0"
                       IsReadOnly="True" IsUndoEnabled="False"
                       BorderThickness="0" Padding="12,8" Background="Transparent"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       Foreground="{StaticResource SyntaxPlain}" />

          <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                        Background="#E3E7EB" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

          <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" Background="#F0F3F6" BorderBrush="#D0D7DE"
                    BorderThickness="0,1,0,1" Padding="12,5">
              <TextBlock FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                         Foreground="#57606A"
                         Text="RECOMMENDED ACTIONS — TICK THE ONES TO KEEP" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Actions}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="4"
                            Background="White" BorderBrush="#E1E6EA" BorderThickness="1">
                      <DockPanel>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0"
                                  IsChecked="{Binding IsAccepted, Mode=TwoWay}" />
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <!-- The priority chip carries the ranking the reviewer was asked for. -->
                            <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#6A737D" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="High">
                                      <Setter Property="Background" Value="#C62828" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Medium">
                                      <Setter Property="Background" Value="#EF6C00" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Low">
                                      <Setter Property="Background" Value="#1565C0" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding PriorityLabel}" Foreground="White"
                                         FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Id}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#6A737D" />
                          </StackPanel>
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,4,0,0"
                                     FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="#24292F" />
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"
                                     FontFamily="Segoe UI" FontSize="12" Foreground="#57606A"
                                     Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#ECEFF1" Padding="12,6" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="Summary" DockPanel.Dock="Right" Foreground="#546E7A"
                   FontFamily="Segoe UI" FontSize="12" Margin="12,0,0,0" />
        <TextBlock DockPanel.Dock="Left" Foreground="#263238" FontFamily="Segoe UI" FontSize="12"
                   Text="{Binding ReviewStatus}" TextTrimming="CharacterEllipsis" MaxWidth="520"
                   Visibility="{Binding ReviewStatus, Converter={StaticResource NotEmptyToVisibility}}" />
        <TextBlock x:Name="FullPath" Foreground="#263238" FontFamily="Segoe UI" FontSize="12"
                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
