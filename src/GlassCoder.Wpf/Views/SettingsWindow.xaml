      </TabItem>

      <!-- ========================== Verification ========================== -->
      <TabItem Header="Verification">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="Compiler feedback">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Verify edits before write" />
                  <CheckBox Content="Compile the edit in memory before it reaches disk"
                            IsChecked="{Binding Settings.Verification.VerifyEditsBeforeWrite}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Refuse breaking edits" />
                  <CheckBox Content="Reject an edit that introduces a new compile error"
                            IsChecked="{Binding Settings.Verification.RejectEditsThatBreakTheBuild}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Pre-existing errors never block an edit - the agent is usually editing precisely because the project is broken." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Identical refusal limit" />
                  <TextBox Text="{Binding Settings.Verification.MaxIdenticalRefusals}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="When identical writes of one file keep being refused, the attempt with this number goes through with a warning and the build adjudicates - the in-memory check can be blind to generated code. Zero keeps refusing without limit." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Max summarised diagnostics" />
                  <TextBox Text="{Binding Settings.Verification.MaxSummarisedDiagnostics}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The summariser reports the first error per file, deduplicates by code, and always states the true total. Raw compiler output would eat the whole context window." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Include warnings" />
                  <CheckBox Content="Report warnings once there are no errors left"
                            IsChecked="{Binding Settings.Verification.IncludeWarningsInSummary}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Max compile files" />
                  <TextBox Text="{Binding Settings.Verification.MaxCompileFiles}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Extra reference directories" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding ExtraReferenceDirectories}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Verify after write" />
                  <CheckBox Content="Climb the ladder after every step that applies a change"
                            IsChecked="{Binding Settings.VerificationLadder.VerifyAppliedChanges}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Syntax, compile and tests run automatically after each applied change, and the first failure goes back to the model. A rung that cannot run is skipped, never failed." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Test filter (rung 4)" />
                  <TextBox Text="{Binding Settings.VerificationLadder.TestFilter}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Passed to dotnet test --filter so the per-step test rung stays cheaper than the full suite. Empty runs every test." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Analyzers (rung 3)" />
                  <CheckBox Content="Run analyzers - they report, they never gate"
                            IsChecked="{Binding Settings.VerificationLadder.RunAnalyzers}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Critique">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Critique" />
                  <CheckBox Content="Ask a panel to refute each change"
                            IsChecked="{Binding Settings.Critique.Enabled}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Critic role" />
                  <ComboBox IsEditable="True" ItemsSource="{Binding RoleNames}" Text="{Binding Settings.Critique.Role}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Ideally a different model family from the worker, so the critic's blind spots are not the worker's blind spots." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Critics" />
                  <TextBox Text="{Binding Settings.Critique.CriticCount}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Refutation threshold" />
                  <TextBox Text="{Binding Settings.Critique.RefutationThreshold}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Zero means a simple majority. An even number of critics can tie." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="A refutation blocks" />
                  <CheckBox Content="Block the change rather than only reporting it"
                            IsChecked="{Binding Settings.VerificationLadder.CritiqueGates}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default: a model refuting a compiler-verified change is a claim worth reading rather than obeying." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================== Sandbox and approval ======================== -->
      <TabItem Header="Sandbox">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="Where commands run">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Mode" />
                  <ComboBox ItemsSource="{Binding SandboxModes}" SelectedItem="{Binding Settings.Sandbox.Mode}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A build is arbitrary code execution: an MSBuild target, a source generator or a test's static constructor is code the agent just wrote. Running the build is exactly as privileged as running bash." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Allow running on the host" />
                  <CheckBox Content="Permit unsandboxed execution"
                            IsChecked="{Binding Settings.Sandbox.AllowUnsandboxedExecution}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default, so a machine without a Docker daemon gets a clear refusal instead of silently running a model's build script against your own filesystem." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Image" />
                  <TextBox Text="{Binding Settings.Sandbox.Image}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Workspace mount point" />
                  <TextBox Text="{Binding Settings.Sandbox.ContainerWorkspacePath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Docker endpoint" />
                  <TextBox Text="{Binding Settings.Sandbox.DockerEndpoint}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Empty uses the platform default named pipe or unix socket." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Network" />
                  <CheckBox Content="Give the container a network"
                            IsChecked="{Binding Settings.Sandbox.AllowNetwork}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Network for restore" />
                  <CheckBox Content="Allow it for a declared restore step only"
                            IsChecked="{Binding Settings.Sandbox.AllowNetworkForRestore}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A build that needs the internet is a build that can exfiltrate the repository. The restore exception is the one legitimate case." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Harden the container" />
                  <CheckBox Content="Read-only root, capabilities dropped, no privilege escalation"
                            IsChecked="{Binding Settings.Sandbox.HardenContainer}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Memory (bytes)" />
                  <TextBox Text="{Binding Settings.Sandbox.MemoryBytes}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Process limit" />
                  <TextBox Text="{Binding Settings.Sandbox.ProcessLimit}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Command timeout (seconds)" />
                  <TextBox Text="{Binding Settings.Sandbox.CommandTimeoutSeconds}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Container environment" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding SandboxEnvironment}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="One NAME=value per line." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="The bash tool">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Enable" />
                  <CheckBox Content="Advertise bash to the model"
                            IsChecked="{Binding Settings.Sandbox.EnableBashTool}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The last capability the harness gains, and exactly as privileged as running a build. It refuses outright unless the mode above is Docker, or unsandboxed execution has been permitted - there is no 'just this once' path onto the host." />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Prefer the dedicated tools wherever one fits: read_file, grep, glob, edit_file, build and run_tests are safer and give the agent better observations to reason about." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Approval">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Approve every write" />
                  <CheckBox Content="Ask before a change is written"
                            IsChecked="{Binding Settings.Approval.RequireApprovalForWrites}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Approval timeout (seconds)" />
                  <TextBox Text="{Binding Settings.Approval.ApprovalTimeoutSeconds}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Silence counts as refusal, not approval: an unattended prompt must never become a write. The console host cannot ask at all, and fails closed." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== Git ============================== -->
      <!-- Retrieval over MCP (workplan tasks 54-63). Deliberately minimal: the switches, the
           mode and the budgets - the things you toggle while using the app. The per-server tool
           allow-lists stay in configuration files, because which two of a server's tools to
           register, and what to tell the model they are for, is arm-shaped rather than
           preference-shaped and is edited about once. -->
      <TabItem Header="Retrieval">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="Documentation and code search">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Enable" />
                  <CheckBox Content="Let the agent look things up over MCP"
                            IsChecked="{Binding Settings.Retrieval.Enabled}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default, and off means absent from the schema rather than present and refusing - a tool the model can see is a tool it can pick. This is the master switch; each server below has its own, so an experiment can move exactly one." />

                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Microsoft Learn" />
                  <CheckBox IsChecked="{Binding Settings.Retrieval.Learn.Enabled}">
                            <!-- A string Content is parsed for access-key mnemonics, so git_status would
                                 render as "gitstatus". A TextBlock is not. -->
                            <TextBlock Text="Register learn_search and learn_fetch" />
                          </CheckBox>
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Learn endpoint" />
                  <TextBox Text="{Binding Settings.Retrieval.Learn.Endpoint}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A trusted publisher with one versioned answer, and no authentication." />

                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="GitHub" />
                  <CheckBox IsChecked="{Binding Settings.Retrieval.GitHub.Enabled}">
                            <!-- A string Content is parsed for access-key mnemonics, so git_status would
                                 render as "gitstatus". A TextBlock is not. -->
                            <TextBlock Text="Register gh_symbol_exists" />
                          </CheckBox>
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="GitHub endpoint" />
                  <TextBox Text="{Binding Settings.Retrieval.GitHub.Endpoint}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Token variable" />
                  <TextBox Text="{Binding Settings.Retrieval.GitHub.ApiKeyEnvironmentVariable}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Public GitHub is not a publisher: anything a search returns is text somebody could have written to be found, reaching an agent that can write files. It arrives marked untrusted, it can never on its own justify a change, and the name here is an environment variable - the token itself never enters a settings file. Turning this on is a good reason to require approval for writes." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Reproducibility">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Mode" />
                  <ComboBox ItemsSource="{Binding RetrievalModes}"
                            SelectedItem="{Binding Settings.Retrieval.Mode}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Replay serves from the recorded corpus and never calls out; a question with no recording fails loudly rather than quietly reaching the network. Record calls out and writes what comes back. Live calls out and records nothing. The suite and the ablation runner use Replay, because two arms are only comparable when they were told the same thing." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Corpus folder" />
                  <TextBox Text="{Binding Settings.Retrieval.CacheDirectory}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Empty puts it under the application data folder, beside the logs. A relative path anchors there too." />

                <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#5D4037"
                               Text="Switching a server on is not enough on its own. A server's tool list is recorded like any other answer, so that a Replay run opens no connection even at startup - which means an empty corpus advertises nothing at all, however many boxes are ticked. Record the lists once here, then save and restart." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="Record tool lists now" Padding="12,4" MinWidth="150"
                              Command="{Binding RecordRetrievalToolsCommand}" />
                      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0"
                                 Foreground="#5D4037" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Budgets">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Calls per run" />
                  <TextBox Text="{Binding Settings.Retrieval.MaxCallsPerRun}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Characters per answer" />
                  <TextBox Text="{Binding Settings.Retrieval.MaxResultChars}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Calls without a change" />
                  <TextBox Text="{Binding Settings.Retrieval.MaxCallsWithoutAppliedChange}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A run that looks things up twice and writes nothing is stalling rather than researching, so retrieval stands down until something has been applied. Zero switches the check off." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Allow unprompted" />
                  <CheckBox Content="Let the agent look things up with nothing indicating it needs to"
                            IsChecked="{Binding Settings.Retrieval.AllowProactive}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default. Normally a call is admitted only when a compile error names something no file here declares - a missing package type is a question documentation answers, and a typo in the agent's own class is one it makes worse. Switch this on to try retrieval by hand without waiting for the right error." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Git">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="The git tools">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Enable" />
                  <CheckBox IsChecked="{Binding Settings.Git.Enabled}">
                            <!-- A string Content is parsed for access-key mnemonics, so git_status would
                                 render as "gitstatus". A TextBlock is not. -->
                            <TextBlock Text="Advertise git_status, git_commit, git_sync, git_push and create_pull_request" />
                          </CheckBox>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default. Git runs on this machine rather than in the sandbox, because the container has neither the network nor the credentials a push needs. GlassCoder holds no token of its own: authentication stays with the credential manager you already signed in to." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Git executable" />
                  <TextBox Text="{Binding Settings.Git.GitExecutable}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="A bare name is resolved through PATH." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Command timeout (seconds)" />
                  <TextBox Text="{Binding Settings.Git.CommandTimeoutSeconds}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Run commit hooks" />
                  <CheckBox Content="Let pre-commit hooks run"
                            IsChecked="{Binding Settings.Git.AllowHooks}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default: a hook is arbitrary code executing on this machine, outside the sandbox, and it may be code the agent has just written. Turn it on only where you own the hooks." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Commits">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Provenance trailer" />
                  <TextBox Text="{Binding Settings.Git.CommitTrailer}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Appended to every commit message as its own paragraph, so an agent commit is recognisable as one. Empty disables it." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Files listed per result" />
                  <TextBox Text="{Binding Settings.Git.MaxListedFiles}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Caps the paths in one observation so a large commit cannot flood the context window. The counts stay truthful whatever this is set to." />
                <TextBlock Style="{StaticResource Hint}"
                           Text="git_commit stages only files inside the writable path set on the Workspace tab. With that list empty nothing is writable and committing is refused." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Publishing">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Approve every push" />
                  <CheckBox Content="Ask before anything leaves this machine"
                            IsChecked="{Binding Settings.Approval.RequireApprovalForPush}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="On by default, unlike approval for writes: a write can be reverted from the change log, a push has already left. Silence counts as refusal, and the console host - which cannot ask anyone - refuses outright." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Remote" />
                  <TextBox Text="{Binding Settings.Git.Remote}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Where git_sync pulls from and git_push pushes to. The model is never offered a force flag or a free-form refspec, so this and the two branch lists are the whole policy." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Pushable branches" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding PushableBranches}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="One per line. Empty means any branch may be pushed." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Protected branches" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding ProtectedBranches}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="One per line, refused whatever the pushable list says and before anyone is asked to approve. Listing your default branch here is how agent work is made to flow through feature branches." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Commits listed per push" />
                  <TextBox Text="{Binding Settings.Git.MaxListedCommits}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Pull requests">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="GitHub CLI" />
                  <TextBox Text="{Binding Settings.Git.GitHubExecutable}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="create_pull_request shells out to gh rather than calling the REST API, so 'gh auth login' holds the credentials and this application never stores a GitHub token." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Base branch" />
                  <TextBox Text="{Binding PullRequestBaseBranch}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Empty targets the repository's default branch." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================== Logging and metrics ======================== -->
      <TabItem Header="Logging">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="Logs">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Directory" />
                  <TextBox Text="{Binding Settings.Logging.Directory}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="JSONL file name" />
                  <TextBox Text="{Binding Settings.Logging.JsonlFileName}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Text file name" />
                  <TextBox Text="{Binding Settings.Logging.TextFileName}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Machine-readable and human-readable side by side. The trailing dash is where the rolling date goes. A relative directory lands under %LOCALAPPDATA%\GlassCoder, not the working directory." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Minimum level" />
                  <ComboBox IsEditable="True" ItemsSource="{Binding LogLevels}"
                            Text="{Binding Settings.Logging.MinimumLevel}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Console" />
                  <CheckBox Content="Also write the human-readable view to the console"
                            IsChecked="{Binding Settings.Logging.Console}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Retained files" />
                  <TextBox Text="{Binding Settings.Logging.RetainedFileCountLimit}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Log source content" />
                  <CheckBox Content="Write prompts, responses and tool results to the log store"
                            IsChecked="{Binding Settings.Logging.LogSourceContent}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The redaction switch. Turning it off keeps the step skeleton - indexes, tool names, statuses, tokens, latencies - and drops every piece of source content. Secrets are scrubbed either way." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Max logged text length" />
                  <TextBox Text="{Binding Settings.Logging.MaxLoggedTextLength}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Redacted property names" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding RedactedPropertyNames}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Matched as whole names, case-insensitively. Substring matching would swallow legitimate properties such as TotalTokens." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Metrics">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Metrics" />
                  <CheckBox Content="Record a JSONL line per run" IsChecked="{Binding Settings.Metrics.Enabled}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Directory" />
                  <TextBox Text="{Binding Settings.Metrics.Directory}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="File name" />
                  <TextBox Text="{Binding Settings.Metrics.FileName}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="One self-describing object per line, appendable from concurrent runs, readable by every dataframe library without a schema." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ====================== Telemetry and provenance ====================== -->
      <TabItem Header="Telemetry">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <GroupBox Header="Tracing">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Tracing" />
                  <CheckBox Content="Trace every model call" IsChecked="{Binding Settings.Telemetry.Enabled}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Service name" />
                  <TextBox Text="{Binding Settings.Telemetry.ServiceName}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Console exporter" />
                  <CheckBox Content="Write spans to the console"
                            IsChecked="{Binding Settings.Telemetry.ConsoleExporter}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="OTLP endpoint" />
                  <TextBox Text="{Binding Settings.Telemetry.OtlpEndpoint}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="For example http://localhost:4317. Empty disables the exporter." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Additional sources" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding AdditionalTelemetrySources}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Provenance and freshness">
              <StackPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Stamp runs" />
                  <CheckBox Content="Record what the working tree and configuration were"
                            IsChecked="{Binding Settings.Provenance.Enabled}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Trigger exclusions" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding TriggerExclusions}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The harness's own output. Counting it as a source change would make every run look stale straight after the previous run wrote its logs - a trigger loop that never settles." />
                <DockPanel Style="{StaticResource Field}">
                  <TextBlock Style="{StaticResource Label}" Text="Source extensions" />
                  <TextBox Style="{StaticResource Multiline}" Text="{Binding SourceExtensions}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
