<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately not in GlassCoder.sln. This builds a brand asset, not the product: adding it to
    the solution would put a tool nobody runs in the path of every build and every CI run, to
    produce a file that changes about once a year. Run it directly when the icon needs changing -
    see README.md in this folder for the command.

    It takes no PackageReference, so central package management has nothing to say about it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>IconGen</RootNamespace>
    <!-- WPF is here for its renderer and its PNG encoder, not for any window. DrawingVisual plus
         RenderTargetBitmap gives geometry, gradients and per-size rendering with nothing to
         install. -->
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
